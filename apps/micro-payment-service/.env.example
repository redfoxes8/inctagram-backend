# Deployment settings for the GraphQL iteration, not a complete Payment MS environment.
# Keep the service's other required settings in the existing deployment configuration.
# This example is not loaded automatically and does not configure a container.

# Existing setting, already mapped from the deployment Secret key RABBITMQ_URL.
# Replace the entire template with that provisioned URL; never commit the real value.
# amqps is a supported example scheme, not a confirmed deployment protocol.
# Actual protocol, host, port, credentials and percent-encoded vhost come from the existing Secret.
RABBITMQ_URL=amqps://<username>:<password>@<broker-host>:<broker-port>/<percent-encoded-vhost>

# New Payment settings: both must be passed explicitly through pipeline/manifest env.
# The runtime default remains false; true here only documents the intended deployment.
PAYMENT_USER_PROJECTION_SYNC_ENABLED=true
# Kubernetes Service name/port from this repository; verify namespace and network access.
GATEWAY_USER_SERVICE_GRPC_URL=main-gateway-service:50050

# Prepare and verify the durable consumer queue/binding before rolling out Gateway writers/relay.
# Confirm all Gateway writer revisions, then complete bootstrap to READY (see the existing plan).
