generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id            String         @id @default(uuid())
  type          PlanType
  duration      Int
  price         Int
  stripeId      String         @map("stripe_id")
  paypalId      String         @map("paypal_id")
  isActive      Boolean        @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?
  subscriptions Subscription[]

  @@index([type])
  @@index([paypalId])
  @@index([stripeId])
}

model Subscription {
  id          String                      @id @default(uuid())
  userId      String                      @map("user_id") @db.Uuid
  planId      String                      @map("plan_id") @db.Uuid
  startsAt    DateTime?                   @map("starts_at")
  endsAt      DateTime?                   @map("ends_at")
  isActive    Boolean                     @default(false) @map("is_active")
  autoRenewal Boolean                     @map("auto_renewal")
  provider    PaymentTransactionProviders @map("provider")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")
  deletedAt   DateTime?
  transaction PaymentTransaction?

  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
}

model PaymentTransaction {
  id             String                      @id @default(uuid())
  provider       PaymentTransactionProviders
  eventId        String                      @unique @map("event_id")
  eventType      String                      @map("event_type")
  subscriptionId String                      @unique @map("subscription_id") @db.Uuid
  status         PaymentTransactionStatus    @default(PENDING)
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
  payload        Json?
  error          String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([provider])
  @@index([eventId])
  @@index([eventType])
  @@index([subscriptionId])
  @@index([status])
}

enum PaymentTransactionProviders {
  PAYPAL
  STRIPE
}

enum PlanType {
  DAILY
  WEEKLY
  MONTHLY
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSED
  FAILED
}
