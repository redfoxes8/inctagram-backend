# Built-in educational fallbacks, explicitly approved also for production (2026-10-21).
# All five env variables are optional: missing/empty/whitespace values use these defaults.
# Nonempty env values override defaults and retain existing validation (invalid is not fallback).
# Email and password hash are resolved independently. Restart/redeploy Gateway after changes.
# Values below may also be manually transferred to the existing deployment configuration.
# This example file is not automatically loaded by deployment.
# Nonempty malformed credentials disable admin login without stopping ordinary REST.
SUPERADMIN_EMAIL=admin@gmail.com
# Educational password: admin. SUPERADMIN_PASSWORD_HASH contains its bcrypt hash (cost 12).
# Preserve the entire hash, including every $; prevent interpolation when copying via shell.
SUPERADMIN_PASSWORD_HASH=$2b$12$xb3LVf8JQXb3dvD.U0/iY.o70yIHYz0aoQ7C2d57ZPf0g7AefwDWi
# Exact frontend origins (scheme, hostname, port), no wildcard/path; do not include /superadmin.
# Missing/empty env uses these two exact origins; other request Origins remain denied.
SUPERADMIN_ALLOWED_ORIGINS=https://nymbi.org,https://dev.nymbi.org:3000
# lax assumes same-site HTTPS frontend/API deployment; actual API address is not confirmed.
# Cross-site requires none (automatically Secure/HTTPS) and browser verification.
SUPERADMIN_COOKIE_SAME_SITE=lax
## Superadmin Payments read timeout (milliseconds, 1..30000; default 3000)
SUPERADMIN_PAYMENTS_TIMEOUT_MS=3000

# Payment MS only: copy to micro-payment-service environment, NOT Gateway.
# PAYMENT_USER_PROJECTION_SYNC_ENABLED=false
# true requires RABBITMQ_URL; export client/address belongs to P1d, not enabled here.
