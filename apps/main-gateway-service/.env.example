# Add these names to the existing Gateway configuration. No real secrets/origins here.
# Empty/malformed credentials disable admin login without stopping ordinary REST.
SUPERADMIN_EMAIL=
# bcrypt digest, cost 10..15, provisioned through the existing secret store.
SUPERADMIN_PASSWORD_HASH=
# Exact comma-separated HTTP(S) origins, no wildcard/path. Empty denies all admin HTTP.
SUPERADMIN_ALLOWED_ORIGINS=
# lax for same-site; none for cross-site (automatically requires Secure/HTTPS).
SUPERADMIN_COOKIE_SAME_SITE=lax
