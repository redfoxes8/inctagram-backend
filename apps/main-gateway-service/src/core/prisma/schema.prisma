generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  PERSONAL
  BUSINESS
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String?  
  isConfirmed       Boolean            @default(false)
  isBanned          Boolean            @default(false)

  accountType       AccountType        @default(PERSONAL)
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now())
  deletedAt         DateTime?
  sessions          Session[]
  emailConfirmation EmailConfirmation?
  passwordRecovery  PasswordRecovery?
  oauthAccounts     OAuthAccount[]
  profile           Profile?

  @@index([email])
}

model Profile {
  id           String    @id @default(uuid())
  userId       String    @unique
  username     String    @unique
  firstName    String?
  lastName     String?
  dateOfBirth  DateTime?
  country      String?
  city         String?
  aboutMe      String?
  avatarFileId String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([userId])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String    @unique
  deviceName String
  ip         String
  iat        Int
  exp        Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  deletedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminSession {
  id                String    @id @default(uuid())
  tokenHash         String    @unique @db.Char(64)
  createdAt         DateTime
  lastSeenAt        DateTime
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
}

enum AdminUserAction {
  BLOCK
  UNBLOCK
  DELETE
}

enum AdminUserActionOutcome {
  BLOCKED
  ALREADY_BLOCKED
  USER_DELETED
  NOT_FOUND
  UNBLOCKED
  ALREADY_ACTIVE
  DELETED
  ALREADY_DELETED
}

// Historical identifiers intentionally have no FK: NOT_FOUND and session cleanup remain auditable.
model AdminUserActionAudit {
  id             String                 @id @default(uuid())
  action         AdminUserAction
  targetUserId   String
  outcome        AdminUserActionOutcome
  occurredAt     DateTime
  adminSessionId String
}

// Bounded sliding-window timestamps, shared by all Gateway instances.
model AdminLoginRateLimit {
  keyHash   String     @id @db.Char(64)
  attempts  DateTime[]
  updatedAt DateTime   @updatedAt

  @@index([updatedAt])
}

model EmailConfirmation {
  id               String    @id @default(uuid())
  userId           String    @unique
  confirmationCode String    @unique
  expirationDate   DateTime
  isConfirmed      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  deletedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordRecovery {
  id             String    @id @default(uuid())
  userId         String    @unique
  recoveryCode   String    @unique
  expirationDate DateTime
  isUsed         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())
  deletedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthAccount {
  id         String   @id @default(uuid())
  userId     String
  provider   String // "google"
  providerId String // ID пользователя в Google (поле sub)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

enum PaymentEntitlementOutcome {
  APPLIED
  DUPLICATE
  STALE
  IGNORED
}

model PaymentEntitlementInbox {
  eventId                String                   @id @db.Uuid
  eventType              String
  userId                 String
  subscriptionId         String                   @db.Uuid
  subscriptionSequence   Int
  receivedAt             DateTime                 @default(now())
  processedAt            DateTime?
  outcome                PaymentEntitlementOutcome
  createdAt              DateTime                 @default(now())

  @@index([userId, subscriptionSequence])
}

model PaymentEntitlementCursor {
  userId                   String   @id
  lastSubscriptionSequence Int
  activeSubscriptionId     String?  @db.Uuid
  updatedAt                DateTime @updatedAt
}

model OutboxEvent {
  id         String      @id @default(uuid()) @db.Uuid
  type       String
  payload    Json
  status     OutboxStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}
